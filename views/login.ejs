<%- include('partials/head', { title: 'Administrator Sign In', active: 'login' }) %>
<section class="form-container login-box"><p class="eyebrow">RESTRICTED ACTIONS</p><h1>Administrator sign in</h1><p class="subheading">Sign in to update or delete student records.</p>
  <% if (typeof formError !== 'undefined' && formError) { %><p class="msg bad" role="alert"><%= formError %></p><% } %>
  <form method="post" action="/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-row"><label for="username">Username</label><input id="username" name="username" type="text" autocomplete="username" required></div><div class="form-row"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required></div><button type="submit">Sign in</button></form>
</section>
<%- include('partials/foot') %>

