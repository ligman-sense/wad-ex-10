<%- include('../partials/head', { title: 'Student Records', active: 'records' }) %>
<section class="form-container wide">
  <div class="page-heading"><div><p class="eyebrow">RECORDS AND EXERCISES</p><h1>Student directory</h1><p class="subheading">Browse the collection and use a query below to practice each Mongoose operation.</p></div><div class="count-pill"><strong><%= totalStudents %></strong><span>total students</span></div></div>
  <div class="exercise-grid">
    <form class="exercise" method="get" action="/"><label for="yearOfAdmission">1 · Admission year</label><input id="yearOfAdmission" name="yearOfAdmission" type="number" min="1900" max="2100" placeholder="e.g. 2023" value="<%= filters.yearOfAdmission %>"><button>Find by year</button></form>
    <form class="exercise" method="get" action="/"><label for="nativeCity">2 · Native city</label><input id="nativeCity" name="nativeCity" type="text" placeholder="e.g. Chennai" value="<%= filters.nativeCity %>"><button>Find by city</button></form>
    <form class="exercise" method="get" action="/"><label for="birthAfter">3 · Born after birth year</label><input id="birthAfter" name="birthAfter" type="number" min="1900" max="2100" placeholder="e.g. 2004" value="<%= filters.birthAfter %>"><button>Find by birth year</button></form>
    <div class="exercise result-exercise"><label>4 · Total student count</label><p><strong><%= totalStudents %></strong> student records in the collection</p></div>
    <form class="exercise" method="get" action="/"><input type="hidden" name="sort" value="admission-desc"><label>5 · Admission year order</label><p>Newest admission year first</p><button>Sort descending</button></form>
    <form class="exercise" method="get" action="/"><input type="hidden" name="guardianMissing" value="1"><label>8 · Guardian phone missing</label><p>Phone absent, blank, or null</p><button>Find missing phones</button></form>
    <form class="exercise search-exercise" method="get" action="/"><label for="name">7 · Search by student name</label><div class="inline-controls"><input id="name" name="name" type="search" placeholder="Type a name" value="<%= filters.name %>"><button>Search</button></div></form>
  </div>
  <div class="sort-controls"><form method="get" action="/students"><label for="sort">Sort students by</label><select id="sort" name="sort"><% [['rollno','Roll Number'],['name','Name'],['yearOfBirth','Year of Birth'],['yearOfAdmission','Year of Admission'],['nativeCity','Native City'],['phoneNumber','Phone Number']].forEach(([value,label]) => { %><option value="<%= value %>" <%= filters.sort === value ? 'selected' : '' %>><%= label %></option><% }) %></select><label for="order">Order</label><select id="order" name="order"><option value="asc" <%= filters.order === 'asc' ? 'selected' : '' %>>Ascending</option><option value="desc" <%= filters.order === 'desc' ? 'selected' : '' %>>Descending</option></select><input type="hidden" name="name" value="<%= filters.name %>"><input type="hidden" name="yearOfAdmission" value="<%= filters.yearOfAdmission %>"><input type="hidden" name="nativeCity" value="<%= filters.nativeCity %>"><input type="hidden" name="birthAfter" value="<%= filters.birthAfter %>"><% if (filters.guardianMissing) { %><input type="hidden" name="guardianMissing" value="1"><% } %><button>Sort</button></form></div>
  <div class="table-heading"><h2>Matching students</h2><a class="button-link" href="/students/add">＋ Add student</a></div>
  <% if (students.length) { %>
    <div class="table-wrap"><table><thead><tr><th>Roll no.</th><th>Name</th><th>Year of birth</th><th>Year of admission</th><th>Native city</th><th>Phone number</th><th>Guardian phone</th><th>Gender</th><% if (isAdmin) { %><th>Actions</th><% } %></tr></thead><tbody>
    <% students.forEach(s => { %><tr><td><%= s.rollno %></td><td><strong><%= s.name %></strong></td><td><%= s.yearOfBirth %></td><td><%= s.yearOfAdmission %></td><td><%= s.nativeCity %></td><td><%= s.phoneNumber %></td><td><%= s.guardianPhoneNumber || 'Not provided' %></td><td><%= s.gender %></td><% if (isAdmin) { %><td class="actions"><a href="/students/edit/<%= s.rollno %>">Edit</a><form method="post" action="/students/delete" onsubmit="return confirm('Delete this student record?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="rollno" value="<%= s.rollno %>"><button class="text-button danger" type="submit">Delete</button></form></td><% } %></tr><% }) %>
    </tbody></table></div>
  <% } else { %><p class="empty-state">No students match these filters. Add a record or clear the filters.</p><% } %>
  <div class="bottom-actions"><a href="/" class="quiet-link">Clear filters and show all students</a></div>
  <p class="auth-note"><strong>Exercise 9 · Authorization:</strong> Administrator sign-in is required before editing or deleting records. New student records remain available from the Add student page.</p>
</section>
<%- include('../partials/foot') %>

